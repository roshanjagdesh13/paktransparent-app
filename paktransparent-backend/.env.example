# ============================================
# PAKTRANSPARENT CONFIGURATION
# ============================================
# Copy this file to .env.local and customize your settings
# All settings have sensible defaults and can be omitted

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Application Name
VITE_APP_NAME=PakTransparent

# Application Description
VITE_APP_DESCRIPTION=Pakistan Public Budget Tracker & Transparency Platform

# ============================================
# API CONFIGURATION
# ============================================

# API Base URL - Change to your backend API URL
VITE_API_BASE_URL=http://localhost:8000/api

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# API Retry Attempts
VITE_API_RETRY_ATTEMPTS=3

# ============================================
# FEATURE FLAGS
# ============================================

# Show sample/demo projects (set to 'false' in production with real data)
VITE_SHOW_MOCK_PROJECTS=true

# Number of sample projects to show (if enabled)
VITE_SAMPLE_PROJECT_COUNT=3

# Enable AI Insights feature
VITE_ENABLE_AI_INSIGHTS=true

# Enable QR Scanner feature
VITE_ENABLE_QR_SCANNER=true

# Enable Notifications
VITE_ENABLE_NOTIFICATIONS=true

# Enable File Upload
VITE_ENABLE_FILE_UPLOAD=true

# Enable Analytics
VITE_ENABLE_ANALYTICS=false

# ============================================
# PAGINATION
# ============================================

# Default page size for lists
VITE_DEFAULT_PAGE_SIZE=20

# ============================================
# FILE UPLOAD LIMITS
# ============================================

# Maximum file size in bytes (default: 52428800 = 50MB)
VITE_MAX_FILE_SIZE=52428800

# Maximum number of files per upload
VITE_MAX_FILES=10

# ============================================
# MAP CONFIGURATION
# ============================================

# Default map center (Pakistan)
VITE_MAP_DEFAULT_LAT=30.3753
VITE_MAP_DEFAULT_LNG=69.3451

# Default map zoom level
VITE_MAP_DEFAULT_ZOOM=6

# ============================================
# CURRENCY & LOCALE
# ============================================

# Currency code
VITE_CURRENCY_CODE=PKR

# Currency symbol
VITE_CURRENCY_SYMBOL=Rs

# Currency locale for formatting
VITE_CURRENCY_LOCALE=en-PK

# ============================================
# DATE & TIME
# ============================================

# Timezone
VITE_TIMEZONE=Asia/Karachi

# Date format (using date-fns format)
VITE_DATE_FORMAT=dd MMM yyyy

# Time format
VITE_TIME_FORMAT=HH:mm

# ============================================
# AUTHENTICATION & SESSION
# ============================================

# Session timeout in milliseconds (default: 3600000 = 1 hour)
VITE_SESSION_TIMEOUT=3600000

# Maximum login attempts before lockout
VITE_MAX_LOGIN_ATTEMPTS=5

# Account lockout duration in milliseconds (default: 900000 = 15 minutes)
VITE_LOCKOUT_DURATION=900000

# ============================================
# PASSWORD REQUIREMENTS
# ============================================

# Minimum password length
VITE_PASSWORD_MIN_LENGTH=8

# Require uppercase letters (true/false)
VITE_PASSWORD_REQUIRE_UPPERCASE=true

# Require lowercase letters (true/false)
VITE_PASSWORD_REQUIRE_LOWERCASE=true

# Require numbers (true/false)
VITE_PASSWORD_REQUIRE_NUMBERS=true

# Require special characters (true/false)
VITE_PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# THEME & APPEARANCE
# ============================================

# Default theme (light, dark, or auto)
VITE_DEFAULT_THEME=light

# Allow users to switch themes (true/false)
VITE_ALLOW_THEME_SWITCH=true

# ============================================
# LANGUAGE & LOCALIZATION
# ============================================

# Default language (en, ur)
VITE_DEFAULT_LANGUAGE=en

# Allow users to switch languages (true/false)
VITE_ALLOW_LANGUAGE_SWITCH=true

# ============================================
# NOTIFICATIONS
# ============================================

# Notification position (top-right, top-left, bottom-right, bottom-left)
VITE_NOTIFICATION_POSITION=top-right

# ============================================
# CONTACT INFORMATION
# ============================================

# Support email
VITE_CONTACT_EMAIL=support@paktransparent.gov.pk

# Support phone
VITE_CONTACT_PHONE=+92-51-9000000

# Office address
VITE_CONTACT_ADDRESS=Islamabad, Pakistan

# Social media links (optional)
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_LINKEDIN=

# ============================================
# ANALYTICS (Optional)
# ============================================

# Google Analytics ID (leave empty to disable)
VITE_GA_ID=

# ============================================
# DEBUG MODE
# ============================================

# Enable debug mode (set to 'true' for detailed logging)
VITE_DEBUG=false

# Log level (debug, info, warn, error)
VITE_LOG_LEVEL=info

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to production, update:
#
# 1. VITE_API_BASE_URL=https://your-api-domain.com/api
# 2. VITE_SHOW_MOCK_PROJECTS=false
# 3. VITE_ENABLE_ANALYTICS=true
# 4. VITE_GA_ID=your-google-analytics-id
# 5. VITE_DEBUG=false
# 6. VITE_LOG_LEVEL=error
# 7. Update VITE_CONTACT_* fields with real information
#
# Remember to never commit .env.local file to version control!
